<?xml version="1.0" encoding="utf-8"?>
<!--
  Finance Pal stores encrypted financial data, receipts, sessions and audit
  logs locally. Never include any app data in Android Auto Backup.
-->
<full-backup-content>
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />
</full-backup-content>
